from database import Database
from auth import AuthService

class UserService(Database):
    def __init__(self):
        super().__init__("UserService")
        self.auth = AuthService("AuthService")

    def create_user(self, u):
        self.auth.login(u)
        self.insert(u)

    def update_user(self, u): self.update(u)
    def delete_user(self, u): self.delete(u)
    def get_user(self, uid): return self.fetch(uid)
    def suspend_user(self, u): self.log("suspend")
    def activate_user(self, u): self.log("activate")
    def audit_user(self, u): self.audit()
    def permissions(self): return self.auth.permissions()
    def roles(self): return self.auth.role_mapping()
    def reset_password(self): self.log("reset password")
    def lock_user(self): self.log("lock")
    def unlock_user(self): self.log("unlock")

